#!/usr/bin/env bash
# tarefas — roda o google_tasks.py com o Python do Hermes, que tem as bibliotecas do Google.
# O instalador cria os ambientes com nomes sorteados; usa o primeiro que importa o googleapiclient.
set -euo pipefail

dir=$(dirname "$(readlink -f "$0")")
home=${HERMES_HOME:-$HOME/.hermes}
for py in "$home"/installs/*/environments/*/venv/bin/python; do
  if [[ -x $py ]] && "$py" -c 'import googleapiclient, google.oauth2' 2>/dev/null; then
    exec "$py" -B "$dir/google_tasks.py" "$@"
  fi
done
echo "tarefas: nenhum Python do Hermes com as bibliotecas do Google em $home/installs" >&2
exit 1
