#!/usr/bin/env bash
# jarvis — ferramenta do administrador para a configuração do Hermes.
#
#   jarvis apply [--force]   repo → Hermes (config.yaml, SOUL.md, skills/jarvis) e reinicia
#   jarvis diff              mostra o que o Hermes/dashboard mudou em relação ao repo
#   jarvis import            traz as mudanças do Hermes para o repo (revise e faça commit)
#   jarvis check-env         confere se o .env do Hermes está completo
#   jarvis status            serviços, dispositivos da VPN, portas públicas, último backup
#   jarvis update            backup + atualização do Hermes + reinício
#   jarvis backup            faz um backup agora (na VPS)
#   jarvis backup pull       baixa os backups da VPS pela VPN (no seu computador)
#   jarvis hermes ARGS...    roda o comando hermes como o usuário hermes
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
export JARVIS_REPO="${JARVIS_REPO:-$(dirname "$(dirname "$SELF")")}"
# shellcheck source=provision/lib.sh
source "$JARVIS_REPO/provision/lib.sh"

# SUDO: comandos de sistema (systemctl, jarvis-peer).
# HSUDO: TUDO que lê ou grava na pasta do Hermes roda COMO o usuário hermes, nunca como root.
# A pasta é do hermes; se root a tocasse, um link simbólico plantado ali viraria escalada para root.
if [[ $EUID -eq 0 ]]; then
  SUDO=${SUDO-}
  HSUDO=${HSUDO-runuser -u $HERMES_USER --}
else
  SUDO=${SUDO-sudo}
  HSUDO=${HSUDO-sudo -u $HERMES_USER}
fi
SYSTEMCTL=${SYSTEMCTL:-$SUDO systemctl}
HERMES_HOME=${HERMES_HOME:-$HERMES_DIR/.hermes}
JARVIS_STATE=${JARVIS_STATE:-/var/lib/jarvis}
BACKUP_DIR=${BACKUP_DIR:-/var/backups/jarvis}
LOCAL_BACKUP_DIR=${LOCAL_BACKUP_DIR:-$HOME/backups/jarvis}
VPS_SSH=${VPS_SSH:-$ADMIN_USER@$WG_SERVER_IP}

SRC="$JARVIS_REPO/hermes"
APPLIED="$JARVIS_STATE/applied"
MANAGED_FILES=(config.yaml SOUL.md)
MANAGED_SKILLS=skills/jarvis
SERVICES=(hermes-gateway hermes-dashboard)
REQUIRED_ENV=(OPENAI_API_KEY TELEGRAM_BOT_TOKEN TELEGRAM_ALLOWED_USERS TELEGRAM_HOME_CHANNEL GITHUB_TOKEN)

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir "$WORK/empty"

# refuse_symlinks — o Hermes não tem motivo para ter links nos itens gerenciados; se tiver, pare.
refuse_symlinks() {
  local p found
  for p in "$HERMES_HOME" "$HERMES_HOME/skills" "$HERMES_HOME/$MANAGED_SKILLS" \
           "${MANAGED_FILES[@]/#/$HERMES_HOME/}" "$HERMES_HOME/.env"; do
    if $HSUDO test -L "$p"; then
      die "link simbólico inesperado no Hermes: $p — investigue e remova antes de continuar"
    fi
  done
  if $HSUDO test -d "$HERMES_HOME/$MANAGED_SKILLS"; then
    found=$($HSUDO find "$HERMES_HOME/$MANAGED_SKILLS" ! -type f ! -type d)
    [[ -z $found ]] || die "link simbólico ou arquivo especial em skills/jarvis: $found"
  fi
}

# export_live DESTINO — copia (como hermes) os itens gerenciados do Hermes para DESTINO.
export_live() {
  local dest=$1 items=() f
  refuse_symlinks
  mkdir -p "$dest"
  for f in "${MANAGED_FILES[@]}" "$MANAGED_SKILLS"; do
    if $HSUDO test -e "$HERMES_HOME/$f"; then items+=("$f"); fi
  done
  if ((${#items[@]})); then
    $HSUDO tar -C "$HERMES_HOME" -cf - "${items[@]}" | tar -C "$dest" -xf -
  fi
  [[ -z $(find "$dest" ! -type f ! -type d) ]] || die "link simbólico ou arquivo especial no Hermes"
}

# _or_empty CAMINHO f|d — o próprio caminho ou um substituto vazio (para o diff).
_or_empty() {
  if [[ -e $1 ]]; then
    echo "$1"
  elif [[ $2 == d ]]; then
    echo "$WORK/empty"
  else
    echo /dev/null
  fi
}

# diff_tree A B — compara só os itens gerenciados; retorna 1 se houver diferença.
diff_tree() {
  local a=$1 b=$2 rc=0 f
  for f in "${MANAGED_FILES[@]}"; do
    diff -u --label "repo/$f" --label "hermes/$f" \
      "$(_or_empty "$a/$f" f)" "$(_or_empty "$b/$f" f)" || rc=1
  done
  diff -ruN "$(_or_empty "$a/$MANAGED_SKILLS" d)" "$(_or_empty "$b/$MANAGED_SKILLS" d)" || rc=1
  return "$rc"
}

# snapshot_from DIR — guarda DIR como "último estado aplicado/importado".
snapshot_from() {
  rm -rf "$APPLIED"
  mkdir -p "$APPLIED"
  chmod 700 "$APPLIED"
  cp -r "$1/." "$APPLIED/"
}

cmd_diff() {
  export_live "$WORK/live"
  diff_tree "$SRC" "$WORK/live" && ok "sem diferenças"
}

cmd_apply() {
  local force=0 f
  if [[ ${1:-} == --force ]]; then force=1; fi

  export_live "$WORK/live"
  if [[ -d $APPLIED ]]; then
    if ! diff_tree "$APPLIED" "$WORK/live" >/dev/null; then
      ((force)) || die "o Hermes tem mudanças que não estão no repo. Veja com 'jarvis diff', traga com 'jarvis import' ou descarte com 'jarvis apply --force'."
      warn "--force: descartando mudanças feitas no Hermes"
    fi
  elif [[ -f $WORK/live/config.yaml ]]; then
    ((force)) || die "primeira vez: rode 'jarvis import' para trazer a configuração atual do Hermes para o repo (ou 'jarvis apply --force')."
  fi

  for f in "${MANAGED_FILES[@]}"; do
    [[ -f $SRC/$f ]] || die "faltando no repo: hermes/$f (na primeira vez, rode 'jarvis import')"
  done
  [[ -d $SRC/$MANAGED_SKILLS ]] || die "faltando no repo: hermes/$MANAGED_SKILLS/"

  # Grava como hermes: remove as skills gerenciadas e extrai a versão do repo.
  $HSUDO rm -rf "$HERMES_HOME/$MANAGED_SKILLS"
  tar -C "$SRC" --mode='u=rwX,g=rX,o=' -cf - "${MANAGED_FILES[@]}" "$MANAGED_SKILLS" |
    $HSUDO tar -C "$HERMES_HOME" -xf -

  export_live "$WORK/aplicado"
  snapshot_from "$WORK/aplicado"
  $SYSTEMCTL restart "${SERVICES[@]}"
  ok "aplicado; serviços reiniciados: ${SERVICES[*]}"
}

cmd_import() {
  local stage="$WORK/stage" f hits
  export_live "$stage"
  for f in "${MANAGED_FILES[@]}"; do
    if [[ ! -f $stage/$f ]]; then warn "não existe no Hermes, mantido no repo como está: hermes/$f"; fi
  done

  if hits=$( (grep -rlE "$SECRET_RE" "$stage"; grep -rliE "$SECRET_KEY_RE" "$stage") | sort -u) && [[ -n $hits ]]; then
    die "possível segredo encontrado em: ${hits//$stage\//hermes/} — tire do arquivo no Hermes (segredos vão no .env) e rode de novo"
  fi

  for f in "${MANAGED_FILES[@]}"; do
    if [[ -f $stage/$f ]]; then cp "$stage/$f" "$SRC/$f"; fi
  done
  if [[ -d $stage/$MANAGED_SKILLS ]]; then
    rm -rf "${SRC:?}/$MANAGED_SKILLS"
    mkdir -p "$SRC/skills"
    cp -r "$stage/$MANAGED_SKILLS" "$SRC/skills/"
  fi

  snapshot_from "$stage"
  git -C "$JARVIS_REPO" status --short -- hermes/ 2>/dev/null || true
  ok "importado. Revise com 'git diff' e faça commit."
}

cmd_check_env() {
  local envf="$HERMES_HOME/.env" v mode missing=()
  if $HSUDO test -L "$envf"; then die "$envf é um link simbólico — investigue"; fi
  $HSUDO test -f "$envf" || die "não encontrado: $envf — veja .env.example"
  for v in "${REQUIRED_ENV[@]}"; do
    $HSUDO grep -qE "^${v}=[^[:space:]]+" "$envf" || missing+=("$v")
  done
  mode=$($HSUDO stat -c %a "$envf")
  [[ $mode == 600 ]] || warn "$envf tem permissão $mode; o certo é 600 (sudo -u $HERMES_USER chmod 600 $envf)"
  ((${#missing[@]} == 0)) || die "preencha no .env: ${missing[*]}"
  ok ".env completo"
}

cmd_status() {
  local s
  log "serviços"
  for s in "${SERVICES[@]}" caddy dnsmasq "wg-quick@$WG_IF" jarvis-backup.timer; do
    printf '  %-24s %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null || true)"
  done
  log "dispositivos da VPN"
  $SUDO /usr/local/sbin/jarvis-peer list 2>/dev/null || echo "  (jarvis-peer indisponível)"
  log "portas abertas fora da VPN e do localhost (esperado: só SSH e WireGuard)"
  ss -Htuln | awk '{print "  " $1, $5}' | grep -vE "[[:space:]](127\.|\[::1\]|$WG_SERVER_IP:)" || true
  log "último backup"
  { ls -1t "$BACKUP_DIR"/*.tar.zst 2>/dev/null || echo "  nenhum"; } | head -1
  echo "  resultado da última execução: $(systemctl show jarvis-backup.service -p Result --value 2>/dev/null || echo '?')"
  log ".env"
  (cmd_check_env) || true
}

cmd_backup() {
  case ${1:-} in
    pull)
      mkdir -p "$LOCAL_BACKUP_DIR"
      rsync -av --ignore-existing "$VPS_SSH:$BACKUP_DIR/" "$LOCAL_BACKUP_DIR/"
      ok "backups em $LOCAL_BACKUP_DIR"
      ;;
    "")
      $SYSTEMCTL start jarvis-backup.service
      # shellcheck disable=SC2012  # nomes gerados pelo jarvis-backup
      ls -1t "$BACKUP_DIR"/*.tar.zst | head -1
      ;;
    *) die "uso: jarvis backup [pull]" ;;
  esac
}

cmd_update() {
  cmd_backup
  log "atualizando o Hermes"
  as_hermes hermes update
  $SYSTEMCTL restart "${SERVICES[@]}"
  cmd_status
}

case ${1:-} in
  apply) shift; cmd_apply "$@" ;;
  diff) cmd_diff ;;
  import) cmd_import ;;
  check-env) cmd_check_env ;;
  status) cmd_status ;;
  update) cmd_update ;;
  backup) shift; cmd_backup "$@" ;;
  hermes) shift; as_hermes hermes "$@" ;;
  *)
    sed -n '2,12p' "$SELF" | sed -E 's/^# ?//'
    exit 2
    ;;
esac
