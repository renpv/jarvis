#!/usr/bin/env bash
# jarvis — ferramenta do administrador para a configuração do Hermes.
#
#   jarvis apply [--force]   repo → Hermes (config.yaml, SOUL.md, skills/jarvis) e reinicia
#   jarvis diff              mostra o que o Hermes/dashboard mudou em relação ao repo
#   jarvis import            traz as mudanças do Hermes para o repo (revise e faça commit)
#   jarvis check-env         confere se o .env do Hermes está completo
#   jarvis check             valida vars.sh, sistema, comandos, .env e token (não altera nada)
#   jarvis deploy            traz o prod do GitHub SÓ se todos os testes passaram (veja docs)
#   jarvis status            serviços, dispositivos da VPN, portas públicas, último backup
#   jarvis update            backup + atualização do Hermes + reinício
#   jarvis backup            faz um backup agora (na VPS)
#   jarvis backup pull       baixa os backups da VPS pela VPN (no seu computador)
#   jarvis hermes ARGS...    roda o comando hermes como o usuário hermes
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
export JARVIS_REPO="${JARVIS_REPO:-$(dirname "$(dirname "$SELF")")}"
# shellcheck source=provision/lib.sh
source "$JARVIS_REPO/provision/lib.sh"

# Comandos rodam como hermes, que não acessa a pasta de onde o admin costuma chamar (/opt/jarvis).
# Tudo aqui usa caminhos absolutos; partir de / evita "Failed to restore initial working directory".
cd /

# SUDO: comandos de sistema (systemctl, jarvis-peer).
# HSUDO: TUDO que lê ou grava na pasta do Hermes roda COMO o usuário hermes, nunca como root.
# A pasta é do hermes; se root a tocasse, um link simbólico plantado ali viraria escalada para root.
if [[ $EUID -eq 0 ]]; then
  SUDO=${SUDO-}
  HSUDO=${HSUDO-runuser -u $HERMES_USER --}
else
  SUDO=${SUDO-sudo}
  HSUDO=${HSUDO-sudo -u $HERMES_USER}
fi
SYSTEMCTL=${SYSTEMCTL:-$SUDO systemctl}
HERMES_HOME=${HERMES_HOME:-$HERMES_DIR/.hermes}
JARVIS_STATE=${JARVIS_STATE:-/var/lib/jarvis}
BACKUP_DIR=${BACKUP_DIR:-/var/backups/jarvis}
LOCAL_BACKUP_DIR=${LOCAL_BACKUP_DIR:-$HOME/backups/jarvis}
VPS_SSH=${VPS_SSH:-$ADMIN_USER@$WG_SERVER_IP}
DEPLOY_TOKEN_FILE=${DEPLOY_TOKEN_FILE:-$HOME/.config/jarvis/github-token}
GITHUB_API=${GITHUB_API:-https://api.github.com}
DEPLOY_BRANCH=${DEPLOY_BRANCH:-prod}
JARVIS_HTTP=${JARVIS_HTTP:-}

SRC="$JARVIS_REPO/hermes"
APPLIED="$JARVIS_STATE/applied"
MANAGED_FILES=(config.yaml SOUL.md)
MANAGED_SKILLS=skills/jarvis
SERVICES=(hermes-gateway hermes-dashboard)
REQUIRED_ENV=(OPENAI_API_KEY TELEGRAM_BOT_TOKEN TELEGRAM_ALLOWED_USERS TELEGRAM_HOME_CHANNEL GITHUB_TOKEN)

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir "$WORK/empty"

# refuse_symlinks — o Hermes não tem motivo para ter links nos itens gerenciados; se tiver, pare.
refuse_symlinks() {
  local p found
  for p in "$HERMES_HOME" "$HERMES_HOME/skills" "$HERMES_HOME/$MANAGED_SKILLS" \
           "${MANAGED_FILES[@]/#/$HERMES_HOME/}" "$HERMES_HOME/.env"; do
    if $HSUDO test -L "$p"; then
      die "link simbólico inesperado no Hermes: $p — investigue e remova antes de continuar"
    fi
  done
  if $HSUDO test -d "$HERMES_HOME/$MANAGED_SKILLS"; then
    found=$($HSUDO find "$HERMES_HOME/$MANAGED_SKILLS" ! -type f ! -type d)
    [[ -z $found ]] || die "link simbólico ou arquivo especial em skills/jarvis: $found"
  fi
}

# export_live DESTINO — copia (como hermes) os itens gerenciados do Hermes para DESTINO.
export_live() {
  local dest=$1 items=() f
  refuse_symlinks
  mkdir -p "$dest"
  for f in "${MANAGED_FILES[@]}" "$MANAGED_SKILLS"; do
    if $HSUDO test -e "$HERMES_HOME/$f"; then items+=("$f"); fi
  done
  if ((${#items[@]})); then
    $HSUDO tar -C "$HERMES_HOME" -cf - "${items[@]}" | tar -C "$dest" -xf -
  fi
  [[ -z $(find "$dest" ! -type f ! -type d) ]] || die "link simbólico ou arquivo especial no Hermes"
}

# _or_empty CAMINHO f|d — o próprio caminho ou um substituto vazio (para o diff).
_or_empty() {
  if [[ -e $1 ]]; then
    echo "$1"
  elif [[ $2 == d ]]; then
    echo "$WORK/empty"
  else
    echo /dev/null
  fi
}

# diff_tree A B — compara só os itens gerenciados; retorna 1 se houver diferença.
diff_tree() {
  local a=$1 b=$2 rc=0 f
  for f in "${MANAGED_FILES[@]}"; do
    diff -u --label "repo/$f" --label "hermes/$f" \
      "$(_or_empty "$a/$f" f)" "$(_or_empty "$b/$f" f)" || rc=1
  done
  diff -ruN "$(_or_empty "$a/$MANAGED_SKILLS" d)" "$(_or_empty "$b/$MANAGED_SKILLS" d)" || rc=1
  return "$rc"
}

# snapshot_from DIR — guarda DIR como "último estado aplicado/importado".
snapshot_from() {
  rm -rf "$APPLIED"
  mkdir -p "$APPLIED"
  chmod 700 "$APPLIED"
  cp -r "$1/." "$APPLIED/"
}

cmd_diff() {
  preflight "user:$HERMES_USER"
  export_live "$WORK/live"
  diff_tree "$SRC" "$WORK/live" && ok "sem diferenças"
}

cmd_apply() {
  preflight "user:$HERMES_USER"
  local force=0 f
  if [[ ${1:-} == --force ]]; then force=1; fi

  export_live "$WORK/live"
  if [[ -d $APPLIED ]]; then
    if ! diff_tree "$APPLIED" "$WORK/live" >/dev/null; then
      ((force)) || die "o Hermes tem mudanças que não estão no repo. Veja com 'jarvis diff', traga com 'jarvis import' ou descarte com 'jarvis apply --force'."
      warn "--force: descartando mudanças feitas no Hermes"
    fi
  elif [[ -f $WORK/live/config.yaml ]]; then
    ((force)) || die "primeira vez: rode 'jarvis import' para trazer a configuração atual do Hermes para o repo (ou 'jarvis apply --force')."
  fi

  for f in "${MANAGED_FILES[@]}"; do
    [[ -f $SRC/$f ]] || die "faltando no repo: hermes/$f (na primeira vez, rode 'jarvis import')"
  done
  [[ -d $SRC/$MANAGED_SKILLS ]] || die "faltando no repo: hermes/$MANAGED_SKILLS/"

  # Grava como hermes: remove as skills gerenciadas e extrai a versão do repo.
  $HSUDO rm -rf "$HERMES_HOME/$MANAGED_SKILLS"
  tar -C "$SRC" --mode='u=rwX,g=rX,o=' -cf - "${MANAGED_FILES[@]}" "$MANAGED_SKILLS" |
    $HSUDO tar -C "$HERMES_HOME" -xf -

  export_live "$WORK/aplicado"
  snapshot_from "$WORK/aplicado"
  $SYSTEMCTL restart "${SERVICES[@]}"
  ok "aplicado; serviços reiniciados: ${SERVICES[*]}"
}

cmd_import() {
  preflight "user:$HERMES_USER"
  local stage="$WORK/stage" f hits
  export_live "$stage"
  for f in "${MANAGED_FILES[@]}"; do
    if [[ ! -f $stage/$f ]]; then warn "não existe no Hermes, mantido no repo como está: hermes/$f"; fi
  done

  if hits=$( (grep -rlE "$SECRET_RE" "$stage"; grep -rliE "$SECRET_KEY_RE" "$stage") | sort -u) && [[ -n $hits ]]; then
    die "possível segredo encontrado em: ${hits//$stage\//hermes/} — tire do arquivo no Hermes (segredos vão no .env) e rode de novo"
  fi

  for f in "${MANAGED_FILES[@]}"; do
    if [[ -f $stage/$f ]]; then cp "$stage/$f" "$SRC/$f"; fi
  done
  if [[ -d $stage/$MANAGED_SKILLS ]]; then
    rm -rf "${SRC:?}/$MANAGED_SKILLS"
    mkdir -p "$SRC/skills"
    cp -r "$stage/$MANAGED_SKILLS" "$SRC/skills/"
  fi

  snapshot_from "$stage"
  git -C "$JARVIS_REPO" status --short -- hermes/ 2>/dev/null || true
  ok "importado. Revise com 'git diff' e faça commit."
}

cmd_check_env() {
  local envf="$HERMES_HOME/.env" v mode missing=()
  if $HSUDO test -L "$envf"; then die "$envf é um link simbólico — investigue"; fi
  $HSUDO test -f "$envf" || die "não encontrado: $envf — veja .env.example"
  for v in "${REQUIRED_ENV[@]}"; do
    $HSUDO grep -qE "^${v}=[^[:space:]]+" "$envf" || missing+=("$v")
  done
  mode=$($HSUDO stat -c %a "$envf")
  [[ $mode == 600 ]] || warn "$envf tem permissão $mode; o certo é 600 (sudo -u $HERMES_USER chmod 600 $envf)"
  ((${#missing[@]} == 0)) || die "preencha no .env: ${missing[*]}"
  ok ".env completo"
}

CHECK_FAIL=0
_item() {   # _item 0|1 TEXTO
  if [[ $1 == 0 ]]; then printf '  ✅ %s\n' "$2"; else printf '  ❌ %s\n' "$2"; CHECK_FAIL=1; fi
}

token_ok() {
  [[ -r $DEPLOY_TOKEN_FILE && -s $DEPLOY_TOKEN_FILE && $(stat -c %a "$DEPLOY_TOKEN_FILE") == 600 ]]
}

cmd_check() {
  local out c l falta=()
  log "verificação (nada é alterado)"
  if out=$(check_vars); then
    _item 0 "variáveis do vars.sh"
  else
    _item 1 "variáveis do vars.sh:"
    while IFS= read -r l; do printf '       - %s\n' "$l"; done <<<"$out"
  fi
  if check_os; then _item 0 "Ubuntu 24.04"; else _item 1 "sistema não é Ubuntu 24.04"; fi
  for c in git curl jq sudo; do command -v "$c" >/dev/null || falta+=("$c"); done
  if ((${#falta[@]} == 0)); then _item 0 "comandos: git curl jq sudo"; else _item 1 "comandos ausentes: ${falta[*]}"; fi
  if (cmd_check_env) >/dev/null 2>&1; then _item 0 ".env do Hermes completo"; else _item 1 ".env do Hermes (detalhes: jarvis check-env)"; fi
  if token_ok; then
    _item 0 "token de deploy ($DEPLOY_TOKEN_FILE)"
  else
    _item 1 "token de deploy ausente ou sem modo 600: $DEPLOY_TOKEN_FILE (Actions: Read-only; docs/aprendizado/80-ci-e-fluxo-git.md)"
  fi
  return "$CHECK_FAIL"
}

# api_get URL — GET autenticado na API do GitHub. O token vai por um descritor de arquivo
# (-H @…), nunca na linha de comando, onde outros usuários poderiam vê-lo com `ps`.
api_get() {
  if [[ -n $JARVIS_HTTP ]]; then
    $JARVIS_HTTP "$1"
    return
  fi
  curl -fsSL --max-time 30 \
    -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
    -H @<(printf 'Authorization: Bearer %s\n' "$(<"$DEPLOY_TOKEN_FILE")") "$1"
}

# sugestoes ARQUIVOS — o que rodar depois do deploy, conforme o que mudou (spec, seção 5).
sugestoes() {
  local f s todos=0
  declare -A quer=()
  while read -r f; do
    case $f in
      hermes/*) quer[apply]=1 ;;
      provision/lib.sh | provision/vars.sh) todos=1 ;;
      provision/10-* | system/apt/* | system/fail2ban/* | system/ssh/*) quer[10-sistema]=1 ;;
      provision/20-* | system/wireguard/* | bin/jarvis-peer) quer[20-wireguard]=1 ;;
      provision/30-* | system/dnsmasq/* | system/caddy/* | system/systemd/caddy-* | system/systemd/dnsmasq-*) quer[30-dns-caddy]=1 ;;
      provision/40-* | system/systemd/hermes-*) quer[40-hermes]=1 ;;
      provision/50-* | system/sudoers/* | bin/jarvis-expose) quer[50-docker-rootless]=1 ;;
      provision/60-* | system/systemd/jarvis-backup* | bin/jarvis-backup) quer[60-backup]=1 ;;
    esac
  done <<<"$1"
  for s in 10-sistema 20-wireguard 30-dns-caddy 40-hermes 50-docker-rootless 60-backup; do
    if ((todos)) || [[ -n ${quer[$s]:-} ]]; then echo "  sudo provision/$s.sh"; fi
  done
  if [[ -n ${quer[apply]:-} ]]; then echo "  jarvis apply"; fi
}

cmd_deploy() {
  local repo=$JARVIS_REPO head sha json run_id name st reply mudou falhas=() exigidos
  preflight cmd:git cmd:curl cmd:jq
  token_ok || die "token de deploy ausente ou sem modo 600: $DEPLOY_TOKEN_FILE — crie conforme docs/aprendizado/80-ci-e-fluxo-git.md"
  [[ $(git -C "$repo" symbolic-ref --short -q HEAD) == "$DEPLOY_BRANCH" ]] ||
    die "$repo não está no branch $DEPLOY_BRANCH (git -C $repo switch $DEPLOY_BRANCH)"
  if [[ -n $(git -C "$repo" status --porcelain) ]]; then
    die "há mudanças locais em $repo — se vieram de 'jarvis import', leve-as por um branch feat/* e PR (docs/operacao.md)"
  fi

  git -C "$repo" fetch -q origin "$DEPLOY_BRANCH" main
  head=$(git -C "$repo" rev-parse HEAD)
  sha=$(git -C "$repo" rev-parse "origin/$DEPLOY_BRANCH")
  if [[ $sha == "$head" ]]; then
    ok "nada novo em $DEPLOY_BRANCH (${head:0:7})"
    return 0
  fi
  git -C "$repo" merge-base --is-ancestor "$head" "$sha" ||
    die "histórico do $DEPLOY_BRANCH foi reescrito (${head:0:7} não é ancestral de ${sha:0:7}); investigue antes de continuar"

  # Regra do GitLab flow conferida AQUI, com o ci/origem.sh já implantado (código confiável):
  # um push direto no prod que também alterasse o origem.sh não passa por esta checagem.
  [[ -x $repo/ci/origem.sh ]] || die "ci/origem.sh ausente no HEAD local — deploy recusado"
  (cd "$repo" && EVENT=push MAIN_REF=origin/main TARGET="$sha" ci/origem.sh) ||
    die "o $DEPLOY_BRANCH tem conteúdo que não veio do main — deploy recusado"

  exigidos=$(git -C "$repo" show "HEAD:ci/testes-exigidos.txt" 2>/dev/null | grep -vE '^[[:space:]]*(#|$)' || true)
  [[ -n $exigidos ]] || die "ci/testes-exigidos.txt ausente ou vazio no HEAD local — deploy recusado"

  # Tokens fine-grained não leem check runs (só GitHub Apps); a API de Actions (permissão
  # "Actions: Read-only") traz os jobs. Só vale a execução do portao-2.yml disparada por PUSH
  # no prod neste commit exato — um job de mesmo nome vindo de outro workflow não conta.
  json=$(api_get "$GITHUB_API/repos/$GITHUB_SLUG/actions/workflows/portao-2.yml/runs?branch=$DEPLOY_BRANCH&event=push&head_sha=$sha&per_page=20") ||
    die "não consegui consultar as execuções no GitHub (token com 'Actions: Read-only'? rede?)"
  run_id=$(jq -r --arg sha "$sha" --arg b "$DEPLOY_BRANCH" \
    '[.workflow_runs[] | select(.head_sha == $sha and .event == "push" and .head_branch == $b)]
     | sort_by(.created_at) | last | .id // empty' <<<"$json")
  [[ -n $run_id ]] || die "nenhuma execução do portao-2 (push no $DEPLOY_BRANCH) para ${sha:0:7} — aguarde o CI ou veja a aba Actions"
  json=$(api_get "$GITHUB_API/repos/$GITHUB_SLUG/actions/runs/$run_id/jobs?filter=latest&per_page=100") ||
    die "não consegui consultar os jobs da execução $run_id"
  while IFS= read -r name; do
    st=$(jq -r --arg n "$name" \
      '[.jobs[] | select(.name == $n)] | sort_by(.started_at) | last
       | if . == null then "ausente" else "\(.status)/\(.conclusion // "-")" end' <<<"$json")
    [[ $st == completed/success ]] || falhas+=("$name: $st")
  done <<<"$exigidos"
  if ((${#falhas[@]})); then
    printf '  - %s\n' "${falhas[@]}" >&2
    die "testes não aprovados no commit ${sha:0:7} — deploy recusado"
  fi
  ok "todos os testes exigidos passaram em ${sha:0:7}"

  log "commits que vão entrar"
  git -C "$repo" log --oneline "$head..$sha"
  git -C "$repo" diff --stat "$head" "$sha"
  read -r -p "Aplicar na VPS? [s/N] " reply || reply=""
  if [[ $reply != s ]]; then
    ok "cancelado; nada mudou"
    return 0
  fi

  mudou=$(git -C "$repo" diff --name-only "$head" "$sha")
  git -C "$repo" merge -q --ff-only "$sha"
  ok "/opt/jarvis em ${sha:0:7}"

  log "próximos passos (você decide; scripts de root não rodam sozinhos)"
  sugestoes "$mudou"
  if grep -q '^hermes/' <<<"$mudou"; then
    read -r -p "Rodar 'jarvis apply' agora? [s/N] " reply || reply=""
    if [[ $reply == s ]]; then cmd_apply; fi
  fi
}

cmd_status() {
  local s
  log "serviços"
  for s in "${SERVICES[@]}" caddy dnsmasq "wg-quick@$WG_IF" jarvis-backup.timer; do
    printf '  %-24s %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null || true)"
  done
  log "dispositivos da VPN"
  $SUDO /usr/local/sbin/jarvis-peer list 2>/dev/null || echo "  (jarvis-peer indisponível)"
  log "portas abertas fora da VPN e do localhost (esperado: só SSH e WireGuard)"
  ss -Htuln | awk '{print "  " $1, $5}' | grep -vE "[[:space:]](127\.|\[::1\]|$WG_SERVER_IP:)" || true
  log "último backup"
  { ls -1t "$BACKUP_DIR"/*.tar.zst 2>/dev/null || echo "  nenhum"; } | head -1
  echo "  resultado da última execução: $(systemctl show jarvis-backup.service -p Result --value 2>/dev/null || echo '?')"
  log ".env"
  (cmd_check_env) || true
}

cmd_backup() {
  case ${1:-} in
    pull)
      mkdir -p "$LOCAL_BACKUP_DIR"
      rsync -av --ignore-existing "$VPS_SSH:$BACKUP_DIR/" "$LOCAL_BACKUP_DIR/"
      ok "backups em $LOCAL_BACKUP_DIR"
      ;;
    "")
      $SYSTEMCTL start jarvis-backup.service
      # shellcheck disable=SC2012  # nomes gerados pelo jarvis-backup
      ls -1t "$BACKUP_DIR"/*.tar.zst | head -1
      ;;
    *) die "uso: jarvis backup [pull]" ;;
  esac
}

cmd_update() {
  cmd_backup
  log "atualizando o Hermes"
  as_hermes hermes update
  $SYSTEMCTL restart "${SERVICES[@]}"
  cmd_status
}

case ${1:-} in
  apply) shift; cmd_apply "$@" ;;
  diff) cmd_diff ;;
  import) cmd_import ;;
  check-env) cmd_check_env ;;
  check) cmd_check ;;
  deploy) cmd_deploy ;;
  status) cmd_status ;;
  update) cmd_update ;;
  backup) shift; cmd_backup "$@" ;;
  hermes) shift; as_hermes hermes "$@" ;;
  *)
    sed -n '2,14p' "$SELF" | sed -E 's/^# ?//'
    exit 2
    ;;
esac
